rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /subject/{code}/photos/{assignmentId}/{file} {
      allow get: if code == '__SYNC_CODE__';
      allow list: if false;
      allow create: if code == '__SYNC_CODE__'
        && resource == null
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 600 * 1024
        && file.matches('^[A-Za-z0-9_-]+-(d|t)[.]jpg$');
      allow update: if false;
      allow delete: if code == '__SYNC_CODE__';
    }
  }
}
