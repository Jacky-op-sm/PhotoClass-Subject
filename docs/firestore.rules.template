rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /subject_profiles/{code} {
      allow get: if code == '__SYNC_CODE__';
      allow list, delete: if false;
      allow create, update: if code == '__SYNC_CODE__'
        && request.resource.data.keys().hasAll(['schemaVersion','app','progress','updatedAt','lastDevice','lastClientSavedAt'])
        && request.resource.data.keys().hasOnly(['schemaVersion','app','progress','updatedAt','lastDevice','lastClientSavedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.app == 'photoclass-subject'
        && request.resource.data.progress is map
        && request.resource.data.progress.version == 1
        && request.resource.data.lastDevice is string
        && request.resource.data.lastClientSavedAt is string
        && request.resource.data.updatedAt == request.time;
    }
  }
}
